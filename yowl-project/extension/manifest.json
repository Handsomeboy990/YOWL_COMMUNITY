{
    "manifest_version": 3,
    "name": "YOWL - Partage rapide",
    "version": "2.0",
    "description": "Partage la page courante sur YOWL Community en un clic.",
    "permissions": [
        "storage",
        "activeTab",
        "contextMenus"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Partager cette page sur YOWL",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png"
        }
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png"
    }
}
