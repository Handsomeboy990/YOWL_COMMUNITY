APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Cache. "database" fonctionne partout et suffit en developpement.
# En production, mettre CACHE_STORE=redis pour sortir les compteurs et les
# reglages de la base. Les sessions et la file restent volontairement sur la
# base : le quota d'un Redis gratuit se consomme vite, et le cache est ce qui
# en tire le meilleur parti.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Un service manage comme Upstash fournit une URL complete, TLS compris.
# REDIS_URL prime sur l'hote et le port ci-dessus.
#   REDIS_URL=rediss://default:<mot-de-passe>@<hote>:6379
REDIS_URL=

# Envoi des emails : reinitialisation de mot de passe, verification d'adresse,
# resume hebdomadaire, campagnes.
#
# "log" n'envoie rien et ecrit le message dans les journaux : c'est ce qu'on
# veut en developpement, et ce qu'on laisse en production tant qu'aucun
# fournisseur n'est branche.
#
# Pour envoyer reellement, mettre "smtp" et remplir les quatre lignes suivantes.
# Brevo, gratuit jusqu'a 300 destinataires par jour :
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<identifiant fourni par Brevo>
#   MAIL_PASSWORD=<cle SMTP fournie par Brevo>
#
# Gmail fonctionne aussi mais compte par destinataire, plafonne a 500 par jour
# et delivre mal le courrier transactionnel : a reserver a un essai.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null

# L'adresse qui apparait dans "De :". Avec un fournisseur, elle doit etre
# verifiee chez lui, sinon le message est refuse a l'envoi.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Disque des medias envoyes par les membres, avatars et images de reviews.
# "public" en local. En production, mettre "s3" et remplir les variables
# ci-dessous : le systeme de fichiers du conteneur ne survit pas a un
# redemarrage, donc les fichiers doivent partir sur un stockage objet.
MEDIA_DISK=public

# Compatible S3. Pour Cloudflare R2 :
#   AWS_DEFAULT_REGION=auto
#   AWS_ENDPOINT=https://<compte>.r2.cloudflarestorage.com
#   AWS_URL=https://<domaine public du bucket>
#   AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Origin used to build the links sent by email
FRONTEND_URL=http://localhost:5173

# Origins allowed by CORS, comma separated. Defaults to FRONTEND_URL.
# List preview deployments explicitly; no wildcard is accepted.
FRONTEND_URLS=http://localhost:5173

# Lifetime of an issued API token, in minutes. Default is 14 days.
SANCTUM_EXPIRATION=20160

# Seeding, local and staging only. Leave empty to have a password generated
# and printed once. The seeder refuses to run when APP_ENV is production.
SEED_ADMIN_EMAIL=admin@yowl.local
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=

# Web push (VAPID). Generate a pair with:
#   php artisan tinker --execute="echo json_encode(Minishlink\WebPush\VAPID::createVapidKeys());"
# VAPID_PUBLIC_KEY must match VITE_VAPID_PUBLIC_KEY on the frontend.
VAPID_SUBJECT=mailto:contact@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Diffusion en direct des notifications. A ne pas confondre avec MAIL_MAILER,
# plus haut : les deux acceptent la valeur "log" et se ressemblent assez pour
# qu'on ecrive l'une a la place de l'autre.
#
# Valeurs acceptees ici, et elles seules : reverb, pusher, ably, log, null.
# Toute autre valeur desactive la diffusion et l'ecrit dans les journaux.
#
# "log" convient partout ou l'hebergement met le service en veille, ce qui est
# le cas de toutes les offres gratuites : Reverb tient une connexion permanente
# et ne survit pas a une mise en sommeil.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Lues par le frontend, elles doivent correspondre aux valeurs ci-dessus.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Reveil planifie. Un hebergement gratuit endort le conteneur apres quelques
# minutes sans trafic, et un conteneur endormi ne tient ni son planificateur ni
# sa file d'attente. Une horloge exterieure appelle POST /cron/<jeton> toutes
# les dix minutes pour le reveiller et lui faire son travail en retard.
#   php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
# Laisser vide sur un hebergement qui ne dort pas : la route repond alors 404.
CRON_TOKEN=
