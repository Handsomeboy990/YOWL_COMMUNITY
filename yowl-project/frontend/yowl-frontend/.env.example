# Frontend environment. Copy to .env and fill in the values.
# Never commit .env itself: every VITE_ value is bundled into the public build.

# Base URL of the Laravel API, including the /api suffix
VITE_BASE_URL=http://localhost:8000/api

# Public base URL of the storage disk serving uploaded media
VITE_STORAGE_URL=http://localhost:8000/storage

# Public VAPID key, must match VAPID_PUBLIC_KEY on the backend
VITE_VAPID_PUBLIC_KEY=

# Application name shown in the interface
VITE_APP_NAME=YOWL Community
